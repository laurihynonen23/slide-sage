# Anthropic API key (optional if you use OpenAI instead)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (optional if you use Anthropic instead)
OPENAI_API_KEY=sk-...

# AI model to use (optional, defaults to claude-sonnet-4-20250514 for Anthropic)
AI_MODEL=claude-sonnet-4-20250514

# Required on hosted deployments if you want uploads/slides/exams to persist
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
